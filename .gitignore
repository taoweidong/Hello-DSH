# dependencies
node_modules/

# npm pack archives (package-lock.json is tracked for reproducible installs)
*.tgz

# delivery artifacts archive: keep the folder (README.md is tracked),
# but never the packed archives themselves
releases/*
!releases/README.md

# agent workspace (local tooling state, not project content)
.workbuddy/

# local ACL recovery tooling backups (machine-local, not project content)
.acl-recovery/
acl-backup-*.json
acl-backup-*.json.ps1
acl-report-*.jsonl

# build / test artifacts
dist/
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
